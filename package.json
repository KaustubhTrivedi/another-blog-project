{
  "name": "kaustubh-trivedi-site",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm install && npm --prefix cms install",
    "dev": "concurrently -n cms,site -c blue,green \"npm:dev:cms\" \"npm:dev:site\"",
    "dev:site": "vite dev --port 3000",
    "dev:cms": "npm --prefix cms run develop",
    "build": "vite build",
    "build:cms": "npm --prefix cms run build",
    "start": "node --env-file-if-exists=.env server.mjs",
    "start:cms": "npm --prefix cms run start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "marked": "^18.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "srvx": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "serve": "^14.2.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
