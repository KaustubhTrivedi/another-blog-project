# Where the blog server reaches Strapi.
STRAPI_URL=http://localhost:1337
# Optional: a read-only Strapi API token. Not needed while the public role can read posts.
STRAPI_TOKEN=
# Shared with cms/.env. Strapi sends it when telling the blog to clear its cache.
REVALIDATE_SECRET=change-me
# How long cached Strapi data counts as fresh, in seconds.
REVALIDATE_SECONDS=60
# Public URL of the blog, used for RSS links. Defaults to the request's origin.
SITE_URL=
